# Public site URL (used for canonical links, sitemap and social sharing).
# On Vercel this falls back to the production domain automatically.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# ---- Appointment enquiry delivery (server-side only) ----
# Requests are emailed to the clinic through Resend (https://resend.com). See README "Appointment form: setup".
# NEVER add a NEXT_PUBLIC_ prefix to these three, and never commit real values.
# Until all three are set (or the Google Sheet below is), the site stays in
# "opening soon" mode and NEVER shows a "submitted" message.
RESEND_API_KEY=
APPOINTMENT_TO_EMAIL=
# Must be an address on a domain verified in Resend, e.g. "RKM Eye Care <appointments@yourdomain.com>"
APPOINTMENT_FROM_EMAIL=

# ---- Google Sheet for appointment requests (server-side only) ----
# Works alongside email or on its own. See README "Google Sheet". Set BOTH or neither.
# Web app URL from Apps Script, ending in /exec
GOOGLE_SHEETS_WEBHOOK_URL=
# A long random string, identical to the script's SHARED_SECRET property
GOOGLE_SHEETS_WEBHOOK_SECRET=

# ---- Spam check for the appointment form (Cloudflare Turnstile, free) ----
# Create a widget at https://dash.cloudflare.com/?to=/:account/turnstile for your domain.
# Set BOTH keys or neither; the check switches on only when both are present.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
