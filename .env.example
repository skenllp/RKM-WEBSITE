# Public site URL (used for canonical links, sitemap and social sharing).
# On Vercel this falls back to the production domain automatically.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# ---- Appointment enquiry delivery (server-side only) ----
# Requests are emailed to the clinic through Resend (https://resend.com). See README "Appointment form: setup".
# NEVER add a NEXT_PUBLIC_ prefix to these three, and never commit real values.
# Until all three are set, the form tells visitors that online requests are
# not available yet and NEVER shows a "submitted" message.
RESEND_API_KEY=
APPOINTMENT_TO_EMAIL=
# Must be an address on a domain verified in Resend, e.g. "RKM Eye Care <appointments@yourdomain.com>"
APPOINTMENT_FROM_EMAIL=
